/* Dark Cybersecurity Theme */
QWidget {
    background-color: #0f1923;
    color: #d1d5db;
    font-family: "Segoe UI", "Arial";
    font-size: 13px;
}

QMainWindow {
    background-color: #0f1923;
}

QMenuBar {
    background-color: #1a2733;
    color: #d1d5db;
    border-bottom: 1px solid #2a3b4c;
}
QMenuBar::item:selected {
    background-color: #0078d4;
}

QPushButton {
    background-color: #1c3b53;
    color: #ffffff;
    border: 1px solid #2a4b6e;
    padding: 6px 16px;
    border-radius: 4px;
}
QPushButton:hover {
    background-color: #2a4b6e;
}
QPushButton:pressed {
    background-color: #0078d4;
}
QPushButton#sendButton {
    background-color: #0078d4;
    border: none;
}
QPushButton#sendButton:hover {
    background-color: #1084e0;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #1a2733;
    color: #d1d5db;
    border: 1px solid #2a3b4c;
    border-radius: 4px;
    padding: 6px;
    selection-background-color: #0078d4;
}

QScrollBar:vertical {
    background: #1a2733;
    width: 8px;
}
QScrollBar::handle:vertical {
    background: #3a5a7c;
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QProgressBar {
    background-color: #1a2733;
    border: 1px solid #2a3b4c;
    border-radius: 4px;
    text-align: center;
    color: white;
}
QProgressBar::chunk {
    background-color: #0078d4;
    border-radius: 4px;
}

QGroupBox {
    background-color: #15202b;
    border: 1px solid #2a3b4c;
    border-radius: 6px;
    margin-top: 10px;
    font-weight: bold;
    color: #e0e6ed;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

QLabel#sectionTitle {
    font-size: 14px;
    font-weight: bold;
    color: #2d9cdb;
    margin-bottom: 4px;
}

QListWidget {
    background-color: #1a2733;
    border: 1px solid #2a3b4c;
    border-radius: 4px;
    color: #d1d5db;
}
QListWidget::item:selected {
    background-color: #0078d4;
}

/* Chat bubbles */
QFrame#chatBubble[role="user"] {
    background-color: #1c3b53;
    border-radius: 10px;
    margin: 4px;
    padding: 8px;
}
QFrame#chatBubble[role="assistant"] {
    background-color: #15202b;
    border-radius: 10px;
    margin: 4px;
    padding: 8px;
}

QTabWidget::pane {
    background-color: #0f1923;
    border: 1px solid #2a3b4c;
}
QTabBar::tab {
    background-color: #1a2733;
    color: #d1d5db;
    padding: 8px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:selected {
    background-color: #0078d4;
    color: white;
}

QStatusBar {
    background-color: #1a2733;
    color: #d1d5db;
    border-top: 1px solid #2a3b4c;
}
/* ── Server page, toasts and approval dialog ─────────────────────────────── */
QLabel#pageTitle {
    font-size: 20px;
    font-weight: bold;
    color: #e0e6ed;
}
QGroupBox#card {
    background-color: #1a2733;
    border: 1px solid #2a3b4c;
    border-radius: 8px;
    padding: 12px 10px 10px 10px;
}
QLabel#mutedText {
    color: #8b98a5;
    font-size: 11px;
}
QLabel#errorText, QLabel#approvalCountdown {
    color: #ef4444;
}
QLabel#metricValue {
    color: #2d9cdb;
    font-weight: bold;
}
QPushButton#primaryButton {
    background-color: #0078d4;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 6px 14px;
}
QPushButton#primaryButton:hover { background-color: #1a8ae0; }
QPushButton#primaryButton:disabled { background-color: #2a3b4c; color: #8b98a5; }
QPushButton#dangerButton {
    background-color: #3a1d24;
    color: #fca5a5;
    border: 1px solid #7f1d1d;
    border-radius: 4px;
    padding: 6px 14px;
}
QTableView {
    background-color: #15202b;
    alternate-background-color: #1a2733;
    gridline-color: #2a3b4c;
    color: #d1d5db;
    border: 1px solid #2a3b4c;
    selection-background-color: #0078d4;
}
QHeaderView::section {
    background-color: #1a2733;
    color: #8b98a5;
    border: none;
    border-bottom: 1px solid #2a3b4c;
    padding: 4px 8px;
}
QDialog#approvalDialog {
    background-color: #0f1923;
}
QFrame#toast {
    background-color: #1a2733;
    border: 1px solid #2a3b4c;
    border-left: 4px solid #2d9cdb;
    border-radius: 6px;
}
QFrame#toast[level="success"] { border-left-color: #22c55e; }
QFrame#toast[level="warning"] { border-left-color: #f59e0b; }
QFrame#toast[level="error"]   { border-left-color: #ef4444; }
QLabel#toastTitle { color: #e0e6ed; font-weight: bold; }
QLabel#toastBody  { color: #b6c2cf; }
QGroupBox#card QLabel, QGroupBox#card QCheckBox {
    background: transparent;
}
