# Ollama on an AMD Radeon GPU (ROCm) as a *user* service — no sudo needed.
# Install (Ollama extracted to ~/.local/opt/ollama, see README "Local AMD GPU"):
#   mkdir -p ~/.config/systemd/user && cp scripts/ollama-rocm.user.service ~/.config/systemd/user/ollama.service
#   systemctl --user daemon-reload && systemctl --user enable --now ollama
#   loginctl enable-linger "$USER"      # optional: keep it running without a login session
[Unit]
Description=Ollama (AMD ROCm GPU)
After=network-online.target

[Service]
ExecStart=%h/.local/opt/ollama/bin/ollama serve
# RX 6000 (gfx103x) is not on ROCm's list; its ISA matches gfx1030.
Environment=HSA_OVERRIDE_GFX_VERSION=10.3.0
# Only the discrete GPU (HIP device 0); the APU's integrated GPU would break kernels.
Environment=HIP_VISIBLE_DEVICES=0
Environment=OLLAMA_HOST=127.0.0.1:11434
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
